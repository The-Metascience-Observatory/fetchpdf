# Copy to .env.local and fill in. Every value is optional except EMAIL.

# Required. Unpaywall will not answer without it, and Crossref doubles the
# rate limit for requests that carry one (10 req/s with, 5 without).
EMAIL=your@email.com

# Defaults to EMAIL when unset.
CROSSREFEMAIL=your@email.com

# Rate-limit lifts, where the provider documents one. All optional; the
# corresponding source degrades to the anonymous tier without them.
SEMANTIC_SCHOLAR_API_KEY=      # 1 -> 100 req/s
ENTREZ_EUTILS_API_KEY=         # NCBI E-utils: 3 -> 10 req/s
OPENALEXAPIKEY=
COREAPIKEY=                    # daily quota, not a rate: 500 requests/day
SCOPUS_API_KEY=

# Elsevier text/data-mining full text. Without it, Elsevier DOIs fall through
# to the open-access routes like any other publisher.
ELSEVIER_TDM_API_KEY=

# Your library's EBSCOhost cluster id, for the opt-in --ebsco route: the
# <cluster> in the research.ebsco.com/c/<cluster>/... URL you land on after
# signing in through your institution. Only read when --ebsco is given.
EBSCO_PROFILE=
